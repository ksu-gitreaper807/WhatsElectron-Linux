{
  "printWidth": 120,
  "singleQuote": true,
  "trailingComma": "all",
  "semi": true,
  "arrowParens": "always",
  "endOfLine": "lf",
  "overrides": [
    { "files": ["*.md", "*.yml", "*.yaml"], "options": { "proseWrap": "preserve", "singleQuote": false } },
    { "files": ["*.html"], "options": { "printWidth": 200 } }
  ]
}
